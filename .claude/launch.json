{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "crumbandco-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "crumbandco-running",
      "url": "http://localhost:3000"
    },
    {
      "name": "crumbandco-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3011"
      ],
      "port": 3011
    }
  ]
}